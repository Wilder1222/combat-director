{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Combat Plan 1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "type": "string",
      "enum": [
        "grounded",
        "epic",
        "colossus"
      ]
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "aspect_ratio": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "const": "single",
      "type": "string"
    },
    "camera_mode": {
      "type": "string",
      "enum": [
        "one-take",
        "multi-shot"
      ]
    },
    "headers": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "cast": {
          "type": "string",
          "minLength": 1
        },
        "scene": {
          "type": "string",
          "minLength": 1
        },
        "budget": {
          "type": "string",
          "minLength": 1
        },
        "continuity": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "goal",
        "cast",
        "scene",
        "budget",
        "continuity"
      ],
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "properties": {
        "fantasy": {
          "type": "boolean"
        },
        "max_scale": {
          "type": "string",
          "enum": [
            "person",
            "arena",
            "landscape"
          ]
        }
      },
      "required": [
        "fantasy",
        "max_scale"
      ],
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "lead_in": {
          "type": "number",
          "minimum": 0
        },
        "tail_out": {
          "type": "number",
          "minimum": 0
        },
        "result_at": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "lead_in",
        "tail_out",
        "result_at"
      ],
      "additionalProperties": false
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "cast": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      },
      "minItems": 2
    },
    "abilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ability"
      },
      "minItems": 0
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "minItems": 0
    },
    "initial_state": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "beats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/beat"
      },
      "minItems": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "provenance",
    "template",
    "duration",
    "aspect_ratio",
    "generation",
    "camera_mode",
    "headers",
    "rules",
    "timing",
    "anchors",
    "cast",
    "abilities",
    "references",
    "initial_state",
    "beats",
    "sections"
  ],
  "additionalProperties": false,
  "$defs": {
    "actor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "prop": {
          "type": "string",
          "minLength": 1
        },
        "hand": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "description",
        "goal",
        "prop",
        "hand"
      ],
      "additionalProperties": false
    },
    "ability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "string",
          "minLength": 1
        },
        "cost": {
          "type": "string",
          "minLength": 1
        },
        "end_condition": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "type": "string",
          "minLength": 1
        },
        "scale": {
          "type": "string",
          "enum": [
            "person",
            "arena",
            "landscape"
          ]
        },
        "supernatural": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "owner",
        "trigger",
        "limit",
        "cost",
        "end_condition",
        "visual",
        "scale",
        "supernatural"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "identity",
            "scene",
            "action",
            "first-frame",
            "last-frame"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "available",
            "bound"
          ]
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "controls": {
          "type": "string",
          "minLength": 1
        },
        "excludes": {
          "type": "string",
          "minLength": 1
        },
        "binding_evidence": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "actors",
        "controls",
        "excludes",
        "binding_evidence"
      ],
      "additionalProperties": false
    },
    "beat": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "actors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "performance": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "action",
              "performance"
            ],
            "additionalProperties": false
          }
        },
        "emotion": {
          "type": "string",
          "minLength": 1
        },
        "camera": {
          "type": "object",
          "properties": {
            "shot_id": {
              "type": "string",
              "minLength": 1
            },
            "transition": {
              "type": "string",
              "enum": [
                "start",
                "continuous",
                "cut"
              ]
            },
            "side": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "axis_bridge": {
              "type": "string"
            }
          },
          "required": [
            "shot_id",
            "transition",
            "side",
            "path",
            "axis_bridge"
          ],
          "additionalProperties": false
        },
        "vfx": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "sound": {
          "type": "string",
          "minLength": 1
        },
        "ability_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "before": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "after": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "intent",
        "actors",
        "emotion",
        "camera",
        "vfx",
        "environment",
        "sound",
        "ability_ids",
        "before",
        "after"
      ],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "beat_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "summary": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "minLength": 1
            },
            "expression": {
              "type": "string",
              "minLength": 1
            },
            "emotion": {
              "type": "string",
              "minLength": 1
            },
            "camera": {
              "type": "string",
              "minLength": 1
            },
            "vfx": {
              "type": "string",
              "minLength": 1
            },
            "environment": {
              "type": "string",
              "minLength": 1
            },
            "sound": {
              "type": "string",
              "minLength": 1
            },
            "continuity": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "action",
            "expression",
            "emotion",
            "camera",
            "vfx",
            "environment",
            "sound",
            "continuity"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "beat_ids",
        "summary"
      ],
      "additionalProperties": false
    }
  }
}
