        "tail_out": {
          "type": "number",
          "minimum": 0
        },
        "result_at": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "lead_in",
        "tail_out",
        "result_at"
      ],
      "additionalProperties": false
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "cast": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      },
      "minItems": 2
    },
    "abilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ability"
      },
      "minItems": 0
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "minItems": 0
    },
    "initial_state": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "beats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/beat"
      },
      "minItems": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      },
      "minItems": 1
    },
    "editorial_reviews": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/editorial_review"
      }
    },
